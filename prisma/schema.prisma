generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 직원 ───────────────────────────────────────────
model Employee {
  id            String   @id @default(uuid())
  employeeNo    String   @unique @map("employee_no")
  name          String
  department    String
  role          String
  userRole      UserRole @default(EMPLOYEE) @map("user_role")
  flexStartTime String   @default("08:30") @map("flex_start_time")
  managerId     String?  @map("manager_id")
  createdAt     DateTime @default(now()) @map("created_at")

  manager          Employee?         @relation("TeamMembers", fields: [managerId], references: [id])
  teamMembers      Employee[]        @relation("TeamMembers")
  capsLogs         RawCapsLog[]
  leaveRecords     ErpLeaveRecord[]
  slackLogs        SlackStatusLog[]

  @@map("employees")
}

enum UserRole {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

// ─── CAPS 원본 로그 ──────────────────────────────────
model RawCapsLog {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  taggedAt   DateTime @map("tagged_at")
  direction  String
  deviceId   String   @map("device_id")
  logDate    DateTime @map("log_date") @db.Date

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, logDate])
  @@map("raw_caps_logs")
}

// ─── ERP 휴가·결재 ───────────────────────────────────
model ErpLeaveRecord {
  id         String    @id @default(uuid())
  employeeId String    @map("employee_id")
  leaveDate  DateTime  @map("leave_date") @db.Date
  leaveType  LeaveType @map("leave_type")
  status     String    @default("APPROVED")
  syncedAt   DateTime  @default(now()) @map("synced_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, leaveDate])
  @@map("erp_leave_records")
}

enum LeaveType {
  ANNUAL
  HALF_AM
  HALF_PM
  SICK
  BUSINESS_TRIP
  SPECIAL
}

// ─── Slack 상태 로그 ─────────────────────────────────
model SlackStatusLog {
  id         String      @id @default(uuid())
  employeeId String      @map("employee_id")
  statusDate DateTime    @map("status_date") @db.Date
  emoji      String?
  labelType  SlackLabel? @map("label_type")
  fetchedAt  DateTime    @default(now()) @map("fetched_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, statusDate])
  @@map("slack_status_logs")
}

enum SlackLabel {
  OUT_OF_OFFICE
  BUSINESS_TRIP
  REMOTE
  VACATION
  SICK
}

// ─── 일별 근태 (Sieve 최종 결과) — src/types/tag.ts의 ProcessedRecord와 1:1 대응 ──────
// employeeId/workDate는 관계형 FK가 아니라 평문 문자열(ExceptionRule/AttendanceOverride와
// 동일 컨벤션) — 실제 employeeId가 uuid가 아니라 "${사원번호}_${정규화이름}" 합성 문자열이고,
// 직원 목록 자체는 별도로 관리되는 소규모(약 400명) JSON이라 FK를 걸 대상이 없다.
// finalStatus/flag는 Prisma enum이 아니라 평문 문자열(한글 값 그대로) — SieveFlag/FinalStatus
// (TS 유니온, 14종 이상)와 enum을 동기화해야 하는 리스크를 없앤다. extra는 자주
// 필터링/집계되지 않는 나머지 필드(verificationNote 등)를 위한 JSON 오버플로우 —
// src/lib/buildRecordSet.ts, src/lib/processRecord.ts 참고.
model DailyAttendance {
  id               String   @id @default(uuid())
  employeeId       String   @map("employee_id")
  workDate         String   @map("work_date")
  dayType          String   @map("day_type")
  clockIn          String?  @map("clock_in")
  clockOut         String?  @map("clock_out")
  effectiveClockIn String?  @map("effective_clock_in")
  regularHours     Float    @default(0) @map("regular_hours")
  overtimeHours    Float    @default(0) @map("overtime_hours")
  nightHours       Float    @default(0) @map("night_hours")
  holidayHours     Float    @default(0) @map("holiday_hours")
  erpOtApplied     Boolean  @default(false) @map("erp_ot_applied")
  leaveType        String?  @map("leave_type")
  erpLeaveAmount   Float?   @map("erp_leave_amount")
  isUnpaidLeave    Boolean  @default(false) @map("is_unpaid_leave")
  isLeader         Boolean  @default(false) @map("is_leader")
  finalStatus      String   @map("final_status")
  flag             String?
  /** 자주 안 쓰는 나머지 필드 JSON 오버플로우: verificationNote, leaveCodesDetail,
   *  rawLeaveCode, breakMinutes, lunchDeducted, dinnerDeducted, rawOvertimeMinutes,
   *  erpApprovedOtHours, isHolidayWork */
  extra            Json     @default("{}")
  calculatedAt     DateTime @default(now()) @map("calculated_at")

  anomalies AttendanceAnomaly[]

  @@unique([employeeId, workDate])
  @@index([employeeId, workDate])
  @@index([workDate])
  @@map("daily_attendance")
}

// ─── 이상치 ──────────────────────────────────────────
model AttendanceAnomaly {
  id               String           @id @default(uuid())
  dailyAttendanceId String          @map("daily_attendance_id")
  anomalyType      AnomalyType      @map("anomaly_type")
  resolutionStatus ResolutionStatus @default(UNRESOLVED) @map("resolution_status")
  resolvedBy       String?          @map("resolved_by")
  hrNote           String?          @map("hr_note")
  hrAction         String?          @map("hr_action")
  flaggedAt        DateTime         @default(now()) @map("flagged_at")
  resolvedAt       DateTime?        @map("resolved_at")

  dailyAttendance DailyAttendance @relation(fields: [dailyAttendanceId], references: [id])
  appeals         AnomalyAppeal[]

  @@map("attendance_anomalies")
}

enum AnomalyType {
  NO_TAG
  LATE_CLOCK_IN
  EARLY_CLOCK_OUT
  NO_CLOCK_OUT
  OVERTIME_EXCESS
}

enum ResolutionStatus {
  UNRESOLVED
  IN_REVIEW
  RESOLVED
  ESCALATED
}

// ─── 이상치 이의신청 ─────────────────────────────────
model AnomalyAppeal {
  id          String   @id @default(uuid())
  anomalyId   String   @map("anomaly_id")
  appealNote  String   @map("appeal_note")
  hrAction    String?  @map("hr_action")
  submittedAt DateTime @default(now()) @map("submitted_at")

  anomaly AttendanceAnomaly @relation(fields: [anomalyId], references: [id])

  @@map("anomaly_appeals")
}

// ─── 정책 설정 ───────────────────────────────────────
model PolicyConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  isLocked    Boolean  @default(false) @map("is_locked")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("policy_config")
}

// ─── 공휴일 ──────────────────────────────────────────
model Holiday {
  id   String   @id @default(uuid())
  date DateTime @unique @db.Date
  name String

  @@map("holidays")
}

// ─── 관리자 수정 이력 (새로고침 후에도 유지) ──────────────
model AttendanceOverride {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  workDate     String   @map("work_date")
  reasonLabel  String?  @map("reason_label")
  memo         String?
  clockIn      String?  @map("clock_in")
  clockOut     String?  @map("clock_out")
  erpOtApplied Boolean? @map("erp_ot_applied")
  erpLeaveType String?  @map("erp_leave_type")
  editHistory  Json     @default("[]") @map("edit_history")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, workDate])
  @@map("attendance_overrides")
}

// ─── Slack 파싱 결과 (공유용) ────────────────────────────
model SlackException {
  id         String   @id @default(uuid())
  empId      String   @map("emp_id")
  empName    String   @map("emp_name")
  date       String
  type       String
  note       String
  rawText    String   @map("raw_text")
  syncedAt   DateTime @default(now()) @map("synced_at")

  @@index([empId, date])
  @@map("slack_exceptions")
}

// ─── 동명이인 Slack 메시지 수동 확정 (재동기화해도 유지) ──
// msgKey = `${slack message ts}::${employee name}` — 한 메시지 안에 동명이인 그룹이
// 여러 개일 수 있어 ts 단독이 아니라 이름까지 합쳐야 그룹별로 고유하게 식별된다.
model SlackNameResolution {
  id        String   @id @default(uuid())
  msgKey    String   @unique @map("msg_key")
  empId     String   @map("emp_id")
  empName   String   @map("emp_name")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("slack_name_resolutions")
}

// ─── 공유 데이터 저장소 (CAPS/ERP 공통 공유) ─────────────
model SharedDataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("shared_data_store")
}

// ─── 근태 메모 (테이블 메모 칸) ──────────────────────────
model AttendanceNote {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  workDate   String   @map("work_date")
  note       String   @default("")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, workDate])
  @@map("attendance_notes")
}

// ─── 직원 ↔ Slack 개인계정 매핑 (DM 발송용) ──────────────
model SlackUserMapping {
  id           String   @id @default(uuid())
  employeeId   String   @unique @map("employee_id")
  employeeName String   @map("employee_name")
  slackUserId  String   @map("slack_user_id")
  slackName    String   @default("") @map("slack_name")
  matchedBy    String   @default("auto") @map("matched_by") // 'auto' | 'manual'
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("slack_user_mappings")
}

// ─── 예외 규칙 (Settings UI → GAS pipeline) ──────────
model ExceptionRule {
  id             String   @id @default(uuid())
  employeeId     String   @map("employee_id")
  employeeName   String   @map("employee_name")
  jobTitle       String   @default("") @map("job_title")
  division       String   @default("")
  team           String   @default("")
  ruleType       String   @map("rule_type")
  excludeFromOt  Boolean  @default(false) @map("exclude_from_ot")
  shortenedHours Float    @default(0) @map("shortened_hours")
  validFrom      String   @default("") @map("valid_from")
  validTo        String   @default("") @map("valid_to")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([ruleType])
  @@map("exception_rules")
}

// ─── 조직도 마스터 (Google Sheet 동기화 대상) ─────────────
// 시트의 "본부 > 팀/파트" 2단계 구조를 self-relation 트리로 표현.
// aliases는 CAPS 부서텍스트 매칭 보조용 — orgChart.ts의 getOrganization()을
// 대체하지 않고 별도 소스로 시작(블래스트 레이디어스 최소화).
model Department {
  id        String   @id @default(uuid())
  name      String
  level     Int      @default(0)
  parentId  String?  @map("parent_id")
  aliases   String[] @default([])
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent    Department?      @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[]     @relation("DeptTree")
  employees EmployeeMaster[]

  @@index([parentId])
  @@map("departments")
}

enum ContractType {
  FULL_TIME   // 정규직
  CONTRACT    // 계약직
  DISPATCHED  // 파견
  INTERN      // 인턴/수습
  EXECUTIVE   // 임원
  OTHER
}

enum MasterEmployeeStatus {
  ACTIVE      // 재직
  ON_LEAVE    // 휴직 (HR 재직상태 — exception_rules의 parental_leave와는 다른 레이어:
              //  이건 "지금 재직 중인가", exception_rules는 "근태 계산에서 제외할 기간")
  RESIGNED    // 퇴사
}

// ─── 직원 마스터 — 조직도 시트 기준 단일 진실 소스 ─────────────
// PK가 rawId(사원번호)인 이유: 앱 전역이 이미 Employee.id = "${rawId}_${정규화이름}"
// compositeKey를 기대하므로, 이 마스터를 rawId로 조인해서 "보강"하는 방식이 블래스트
// 레이디어스가 가장 작다. compositeKey 자체는 저장하지 않음 — 이름 표기가 흔들려도
// rawId는 안정적이므로 조인 시점에 그때그때 계산.
model EmployeeMaster {
  rawId           String   @id @map("raw_id")
  name            String
  departmentId    String?  @map("department_id")
  jobTitle        String   @default("") @map("job_title")
  contractType    ContractType @default(FULL_TIME) @map("contract_type")
  status          MasterEmployeeStatus @default(ACTIVE)
  hireDate        String?  @map("hire_date")
  resignedDate    String?  @map("resigned_date")
  /** 'sheet' | 'manual' — 시트 동기화로 생성/갱신됐는지, 관리자가 수기로 등록했는지 */
  source          String   @default("sheet")
  /** 마지막으로 조직도 시트에서 이 사람을 확인한 시각 — 퇴사 후보 감지에 사용 */
  lastSeenSheetAt DateTime? @map("last_seen_sheet_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([status])
  @@map("employee_master")
}

// ─── 조직도 시트 이름/부서 ↔ CAPS 사원번호 수동 확정 (재동기화해도 유지) ───
// SlackNameResolution과 동일 골격. matchKey는 탭명이 아니라 (이름,팀) 정규화
// 조합으로 잡아야 시트가 새 탭을 추가해도 같은 사람에게 재적용된다.
model SheetNameResolution {
  id            String   @id @default(uuid())
  matchKey      String   @unique @map("match_key")
  sheetName     String   @map("sheet_name")
  sheetDept     String   @map("sheet_dept")
  resolvedRawId String   @map("resolved_raw_id")
  resolvedAt    DateTime @default(now()) @map("resolved_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("sheet_name_resolutions")
}

// ─── 조직도 시트 탭(날짜 스냅샷) 원본 보관 — 발령이력 재구성/디버깅용 ───
// 시트가 "변경 있을 때마다 새 탭 추가" 방식이라 과거 탭이 언제 사라질지 예측
// 불가 — 원본을 못 붙잡으면 발령이력을 영구히 재구성할 수 없다.
model OrgChartSnapshot {
  id           String   @id @default(uuid())
  tabName      String   @map("tab_name")
  tabDate      String   @map("tab_date")
  rawGrid      Json     @map("raw_grid")
  parsedRows   Json     @map("parsed_rows")
  sheetTotals  Json     @map("sheet_totals")
  parsedTotals Json     @map("parsed_totals")
  sanityPassed Boolean  @default(false) @map("sanity_passed")
  syncedAt     DateTime @default(now()) @map("synced_at")
  /** 'cron' | 'manual' */
  syncTrigger  String   @default("manual") @map("sync_trigger")

  @@unique([tabName])
  @@index([tabDate])
  @@map("org_chart_snapshots")
}
